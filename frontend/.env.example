# Local `npm run dev` / `npm run build` settings: copy to .env.local.
# Next.js inlines NEXT_PUBLIC_* values into the browser bundle, so never put a secret
# here. The Gemini key belongs only in the repository-root .env, for the backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_MAX_UPLOAD_MB=10
