# Copy to .env and fill in locally. Never commit .env.
# The two secrets below MUST be replaced: the backend refuses to start with the
# placeholder or with anything shorter than 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=development
APP_SECRET_KEY=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

# Auth cookie and request hardening. COOKIE_SECURE must be true behind HTTPS
# (required when APP_ENV=production). ALLOWED_HOSTS is a comma-separated Host allowlist.
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Login/registration rate limits per fixed window (seconds).
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_FAILURE_LIMIT_PER_EMAIL=5
REGISTER_RATE_LIMIT_PER_IP=5

# Read by the db container (POSTGRES_*) and by the backend (DATABASE_URL).
POSTGRES_DB=knowbase
POSTGRES_USER=knowbase
POSTGRES_PASSWORD=local-development-password
DATABASE_URL=postgresql+psycopg://knowbase:local-development-password@db:5432/knowbase

# Backend only. Create the key in Google AI Studio; do not enable billing.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
# low | medium | high. Thinking tokens count toward max_output_tokens.
GEMINI_THINKING_LEVEL=low
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=8
GEMINI_MAX_OUTPUT_TOKENS=1200
# Per-request timeout, also sent to Gemini as its server-side deadline.
GEMINI_REQUEST_TIMEOUT_SECONDS=90
# Bounded exponential backoff for 429 rate limits and 5xx/network errors only.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1
GEMINI_RETRY_MAX_DELAY_SECONDS=20

UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=10
# Documents with less extracted text than this are rejected (no OCR for scanned PDFs).
MIN_DOCUMENT_CHARS=50
# Paragraph-aware chunking (characters). Needs OVERLAP < TARGET <= MAX.
CHUNK_TARGET_CHARS=1800
CHUNK_MAX_CHARS=2400
CHUNK_OVERLAP_CHARS=250

# Host port for the API (compose only). If you change it, change NEXT_PUBLIC_API_BASE_URL too.
API_HOST_PORT=8000

FRONTEND_ORIGIN=http://localhost:3000
# Frontend only; inlined into the browser bundle at build time. Never put a secret here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

DAILY_CHAT_REQUEST_LIMIT=30
DAILY_EMBEDDING_TEXT_LIMIT=300

WORKER_POLL_SECONDS=5
# Durable job queue: attempts per job, lock lease (crash recovery), heartbeat, retry backoff base.
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_RETRY_BASE_SECONDS=30
