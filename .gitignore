node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# --- Build output ---
build/
dist/

# --- Local data: uploads, database files, volumes ---
/data/
uploads/
postgres_data/
uploads_data/
*.sqlite3
*.dump

# --- Logs ---
logs/
*.log

# --- OS / editor ---
.DS_Store
.idea/
*.swp

# --- Private benchmark data (kept on disk, never tracked) ---
# The full Asia Cement benchmark holds the sealed held-out split; only its development
# split (asia-cement-realworld-dev-v1.json) is public. The authoring folder and the
# source PDFs stay local too.
/backend/app/evaluation/datasets/asia-cement-realworld-v1.json
/asia-cement/

# --- Local-only development and agent files (kept on disk, not tracked) ---
/SPEC.md
/PROJECT_STATUS.md
/frontend/AGENTS.md
/.github/PULL_REQUEST_TEMPLATE.md
/docs/interview/
/docs/decisions/
/docs/m00-compatibility-report.md
